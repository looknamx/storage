@echo off
title ติดตั้งระบบบริหารรถบริษัท คลังอะไหล่ และประวัติซ่อมบำรุง
chcp 65001 > nul
cd /d "%~dp0"

echo =====================================================================
echo    ยินดีต้อนรับสู่โปรแกรมติดตั้งระบบบริหารรถและคลังอะไหล่
echo =====================================================================
echo.

:: 1. ตรวจสอบว่าเครื่องมี Node.js หรือยัง
echo [1/3] ตรวจสอบโปรแกรมพื้นฐาน...
where node >nul 2>nul
if %errorlevel% neq 0 (
    echo [!] ไม่พบ Node.js ในเครื่อง กำลังเปิดหน้าต่างดาวน์โหลด Node.js ให้ท่าน...
    start https://nodejs.org/dist/v20.18.0/node-v20.18.0-x64.msi
    echo กรุณากดติดตั้งไฟล์ที่ดาวน์โหลดมา แล้วกลับมาดับเบิลคลิกไฟล์นี้ใหม่อีกครั้งครับ
    pause
    exit /b
)

:: 2. ติดตั้ง Dependencies และฐานข้อมูล
echo [2/3] กำลังติดตั้งระบบและเตรียมฐานข้อมูล (กรุณารอสักครู่)...
call npm install
call npx prisma db push

:: 3. สร้างไอคอนทางลัดบน Desktop
echo [3/3] กำลังสร้างไอคอนบนหน้าจอ Desktop...
powershell -ExecutionPolicy Bypass -File "%~dp0create-desktop-shortcut.ps1"

echo.
echo =====================================================================
echo   ติดตั้งระบบเรียบร้อยแล้ว! กำลังเปิดโปรแกรม...
echo =====================================================================
echo.

start http://localhost:3000
npm run dev

pause
