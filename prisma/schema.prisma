// Prisma Schema for Garage Storage & Fleet Vehicle Maintenance Management System
// Database: SQLite (stored at ./data/storage.db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ข้อมูลรถบริษัท ====================

model Vehicle {
  id              String   @id @default(cuid())
  code            String   @unique // รหัสรถภายใน
  licensePlate    String   @unique // ทะเบียนรถ
  province        String   // จังหวัดทะเบียน
  brand           String   // ยี่ห้อ
  model           String   // รุ่น
  vehicleType     String   // ประเภทรถ
  year            Int?     // ปีรถ
  vin             String?  // เลขตัวถัง VIN
  engineNumber    String?  // เลขเครื่องยนต์
  department      String?  // หน่วยงาน/แผนก
  responsiblePerson String? // ผู้ดูแลรถ
  startDate       DateTime? // วันที่เริ่มใช้งาน
  currentMileage  Float    @default(0) // เลขไมล์ล่าสุด
  mileageDate     DateTime? // วันที่อัปเดตเลขไมล์ล่าสุด
  status          String   @default("active") // active, waiting_repair, repairing, waiting_parts, inactive, decommissioned
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  odometerReadings  OdometerReading[]
  repairOrders      RepairOrder[]
  partIssues        PartIssue[]
  maintenancePlans  MaintenancePlan[]
  maintenanceRecords MaintenanceRecord[]
}

model OdometerReading {
  id          String   @id @default(cuid())
  vehicleId   String
  reading     Float    // เลขไมล์
  readingDate DateTime // วันที่อ่าน
  source      String   @default("manual") // manual, repair_order, maintenance
  referenceId String?  // อ้างอิงใบงานหรือรายการบำรุงรักษา
  notes       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
}

// ==================== คลังอะไหล่ ====================

model PartCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parts Part[]
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  contactInfo String?
  address     String?
  phone       String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parts             Part[]
  stockReceipts     StockReceipt[]
}

model Part {
  id              String   @id @default(cuid())
  code            String   @unique // รหัสอะไหล่
  name            String   // ชื่ออะไหล่
  categoryId      String?  // หมวดหมู่
  brand           String?  // ยี่ห้อ
  compatibleModels String? // รุ่นที่ใช้ได้
  unit            String   @default("ชิ้น") // หน่วยนับ
  quantity        Float    @default(0) // จำนวนคงเหลือ
  minimumStock    Float    @default(0) // จำนวนขั้นต่ำ
  costPerUnit     Float    @default(0) // ราคาทุนต่อหน่วย
  location        String?  // ตำแหน่งจัดเก็บ
  supplierId      String?  // ผู้จำหน่าย
  description     String?
  notes           String?
  isActive        Boolean  @default(true) // สถานะการใช้งาน
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category          PartCategory?      @relation(fields: [categoryId], references: [id])
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  stockReceiptItems StockReceiptItem[]
  partIssueItems    PartIssueItem[]
  inventoryTransactions InventoryTransaction[]
}

// ==================== รับอะไหล่เข้า ====================

model StockReceipt {
  id              String   @id @default(cuid())
  receiptNumber   String   @unique // เลขที่เอกสารรับเข้า
  receiptDate     DateTime // วันที่รับเข้า
  supplierId      String?  // ผู้จำหน่าย
  purchaseOrderRef String? // เลขที่ใบสั่งซื้อ
  receivedBy      String?  // ผู้รับสินค้า
  totalAmount     Float    @default(0) // มูลค่ารวม
  notes           String?
  status          String   @default("completed") // draft, completed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  items    StockReceiptItem[]
}

model StockReceiptItem {
  id            String   @id @default(cuid())
  receiptId     String
  partId        String
  quantity      Float    // จำนวน
  costPerUnit   Float    // ราคาทุนต่อหน่วย
  totalCost     Float    // ราคารวม
  notes         String?
  createdAt     DateTime @default(now())

  receipt StockReceipt @relation(fields: [receiptId], references: [id])
  part    Part         @relation(fields: [partId], references: [id])
}

// ==================== เบิกจ่ายอะไหล่ ====================

model PartIssue {
  id              String   @id @default(cuid())
  issueNumber     String   @unique // เลขที่ใบเบิก
  issueDate       DateTime // วันที่เบิก
  vehicleId       String?  // ทะเบียนรถปลายทาง
  repairOrderId   String?  // เลขที่ใบงานซ่อม
  issuedBy        String?  // ผู้เบิก
  totalAmount     Float    @default(0) // มูลค่ารวม
  notes           String?
  status          String   @default("completed") // draft, completed, cancelled
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id])
  repairOrder RepairOrder? @relation(fields: [repairOrderId], references: [id])
  items       PartIssueItem[]
  partReturns PartReturn[]
}

model PartIssueItem {
  id            String   @id @default(cuid())
  issueId       String
  partId        String
  quantity      Float    // จำนวนที่เบิก
  costPerUnit   Float    // ราคาทุนต่อหน่วย
  totalCost     Float    // ราคารวม
  returnedQty   Float    @default(0) // จำนวนที่คืนแล้ว
  notes         String?
  createdAt     DateTime @default(now())

  issue PartIssue @relation(fields: [issueId], references: [id])
  part  Part      @relation(fields: [partId], references: [id])
}

// ==================== คืนอะไหล่ ====================

model PartReturn {
  id            String   @id @default(cuid())
  returnNumber  String   @unique // เลขที่ใบคืน
  returnDate    DateTime // วันที่คืน
  issueId       String   // อ้างอิงใบเบิก
  partId        String   // อะไหล่ที่คืน
  quantity      Float    // จำนวนที่คืน
  condition     String   @default("good") // good, damaged
  reason        String?  // เหตุผล
  returnedBy    String?  // ผู้ทำรายการ
  notes         String?
  createdAt     DateTime @default(now())

  issue PartIssue @relation(fields: [issueId], references: [id])
}

// ==================== ประวัติการเคลื่อนไหวสต็อก ====================

model InventoryTransaction {
  id              String   @id @default(cuid())
  partId          String
  transactionType String   // receive, issue, return, adjust
  quantity        Float    // จำนวน (บวก = เพิ่ม, ลบ = ลด)
  previousQty     Float    // จำนวนก่อนทำรายการ
  newQty          Float    // จำนวนหลังทำรายการ
  referenceType   String?  // receipt, issue, return, adjustment
  referenceId     String?  // เลขอ้างอิงเอกสาร
  referenceNumber String?  // เลขที่เอกสาร
  vehicleId       String?  // ทะเบียนรถ (ถ้ามี)
  repairOrderId   String?  // ใบงานซ่อม (ถ้ามี)
  reason          String?  // เหตุผล
  performedBy     String?  // ผู้ทำรายการ
  transactionDate DateTime @default(now())
  createdAt       DateTime @default(now())

  part Part @relation(fields: [partId], references: [id])
}

// ==================== ใบงานซ่อม ====================

model RepairOrder {
  id                String    @id @default(cuid())
  orderNumber       String    @unique // เลขที่ใบงาน
  vehicleId         String    // ทะเบียนรถ
  mileageAtRepair   Float?    // เลขไมล์ขณะเข้าซ่อม
  reportedBy        String?   // ผู้แจ้งซ่อม
  department        String?   // หน่วยงาน
  reportedSymptoms  String?   // อาการที่แจ้ง
  diagnosis         String?   // ผลการตรวจสอบ
  assignedTo        String?   // ผู้รับผิดชอบงานซ่อม
  laborCost         Float     @default(0) // ค่าแรง
  partsCost         Float     @default(0) // ค่าอะไหล่
  otherCost         Float     @default(0) // ค่าใช้จ่ายอื่น
  totalCost         Float     @default(0) // ค่าใช้จ่ายรวม
  status            String    @default("open") // open, inspecting, waiting_parts, repairing, testing, completed, delivered, cancelled
  orderDate         DateTime  @default(now()) // วันที่เปิดใบงาน
  startDate         DateTime? // วันที่เริ่มซ่อม
  completedDate     DateTime? // วันที่ซ่อมเสร็จ
  deliveredDate     DateTime? // วันที่ส่งมอบรถ
  testResult        String?   // ผลการทดสอบหลังซ่อม
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vehicle    Vehicle          @relation(fields: [vehicleId], references: [id])
  items      RepairOrderItem[]
  partIssues PartIssue[]
}

model RepairOrderItem {
  id            String   @id @default(cuid())
  repairOrderId String
  description   String   // รายละเอียดงานซ่อม
  laborCost     Float    @default(0) // ค่าแรงรายการนี้
  partsCost     Float    @default(0) // ค่าอะไหล่รายการนี้
  otherCost     Float    @default(0) // ค่าใช้จ่ายอื่น
  status        String   @default("pending") // pending, in_progress, completed
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id])
}

// ==================== แผนซ่อมบำรุง ====================

model MaintenancePlan {
  id                  String   @id @default(cuid())
  vehicleId           String
  name                String   // ชื่อรายการบำรุงรักษา
  intervalMonths      Int?     // รอบระยะเวลา (เดือน)
  intervalKm          Float?   // รอบระยะทาง (กม.)
  lastPerformedDate   DateTime? // วันที่ทำครั้งล่าสุด
  lastPerformedMileage Float?  // เลขไมล์ครั้งล่าสุด
  nextDueDate         DateTime? // วันที่ครบกำหนดครั้งถัดไป
  nextDueMileage      Float?   // เลขไมล์ที่ครบกำหนดครั้งถัดไป
  advanceWarningDays  Int      @default(30) // เตือนล่วงหน้า (วัน)
  advanceWarningKm    Float    @default(1000) // เตือนล่วงหน้า (กม.)
  status              String   @default("normal") // normal, upcoming, due, overdue
  isActive            Boolean  @default(true)
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  records MaintenanceRecord[]
}

model MaintenanceRecord {
  id                String   @id @default(cuid())
  planId            String
  vehicleId         String
  performedDate     DateTime // วันที่ดำเนินการ
  mileageAtService  Float?   // เลขไมล์ขณะบำรุงรักษา
  description       String?  // รายละเอียด
  cost              Float    @default(0) // ค่าใช้จ่าย
  performedBy       String?  // ผู้ดำเนินการ
  repairOrderId     String?  // ใบงานซ่อมที่เกี่ยวข้อง
  notes             String?
  createdAt         DateTime @default(now())

  plan    MaintenancePlan @relation(fields: [planId], references: [id])
  vehicle Vehicle         @relation(fields: [vehicleId], references: [id])
}

// ==================== การแจ้งเตือน ====================

model Notification {
  id          String   @id @default(cuid())
  type        String   // maintenance_due, low_stock, overdue_repair, etc.
  title       String
  message     String
  referenceType String? // vehicle, part, repair_order, maintenance_plan
  referenceId String?
  isRead      Boolean  @default(false)
  priority    String   @default("normal") // low, normal, high, critical
  createdAt   DateTime @default(now())
}

// ==================== บันทึกการดำเนินงาน ====================

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // create, update, delete, cancel, adjust
  entityType  String   // vehicle, part, repair_order, etc.
  entityId    String
  description String?
  oldValue    String?  // JSON of old values
  newValue    String?  // JSON of new values
  performedBy String?
  createdAt   DateTime @default(now())
}

// ==================== ตั้งค่าระบบ ====================

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String?
  group String? // general, notification, backup, etc.
  updatedAt DateTime @updatedAt
}

// ==================== ประเภทรถ ====================

model VehicleType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== ระบบแผนงานการตลาด & ขนส่ง (Marketing & Transport Logistics) ====================

model MarketingCustomer {
  id          String   @id @default(cuid())
  code        String?  @unique
  name        String   @unique
  contactInfo String?
  address     String?
  phone       String?
  taxId       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs        TransportJob[]
}

model TransportJob {
  id              String    @id @default(cuid())
  itemNo          Int?      // ลำดับที่
  jobDate         DateTime? // วดป.รับงาน
  jobMonth        String?   // เดือนรับงาน เช่น ก.ค., ส.ค.
  jobYear         Int?      // ปี เช่น 2569
  loadingDate     DateTime? // วันที่รับสินค้า / วันขึ้นสินค้า
  loadingTime     String?   // เวลาขึ้นสินค้า
  deliveryDate    DateTime? // วันลงสินค้า
  deliveryTime    String?   // เวลาลงของ
  isApproved      Boolean   @default(false) // OK

  // การวางบิลและการเงินรับ
  billingDate     DateTime? // วันที่วางบิล
  invoiceNo       String?   // เลขที่วางบิล เช่น IV.6907/019
  jobOrderNo      String?   // Job Order
  isPaid          Boolean   @default(false) // รับชำระแล้ว
  paymentDate     DateTime? // วันที่รับชำระ

  // รถและคนขับ
  isSubcontractor Boolean   @default(false) // รถร่วม (true = รถร่วม, false = รถบริษัท)
  vehicleType     String?   // ประเภทรถ
  licensePlate    String    // ทะเบียน เช่น "นม.71-1726 , 71-1036"
  driverName      String    // ชื่อ-สกุลคนขับ
  vehicleId       String?   // เชื่อมโยงกับ Vehicle ถ้ามี

  // ลูกค้าและเส้นทาง
  customerId      String?
  customerName    String    // ชื่อลูกค้า เช่น บริษัท น้ำตาลครบุรี จำกัด (มหาชน)
  origin          String    // ต้นทาง เช่น บางปู, ครบุรี, เสิงสาง
  weightTicketNo  String?   // เลขที่ใบชั่ง
  destination     String    // ปลายทาง เช่น อ.คง, อ่าวไทย, ปลาวาฬ
  details         String?   // รายละเอียด / ข้อมูลเพิ่มเติม เช่น อนุโลมจ่ายพิเศษ, มีของกลับ

  // รายได้
  weightKg        Float     @default(0) // น้ำหนัก (กก.)
  rateType        String    @default("per_ton") // per_ton, lump_sum
  ratePerTon      Float     @default(0) // ราคาต่อตัน หรือราคาต่อหน่วย
  grossAmount     Float     @default(0) // จำนวนเงิน (น้ำหนัก/เหมา)
  withholdingTax  Float     @default(0) // หัก ณ ที่จ่าย 1%
  netRevenue      Float     @default(0) // จำนวนเงินสุทธิ (grossAmount - withholdingTax)

  // กรณีรถร่วม (Subcontractor)
  subcontractorRate     Float?  @default(0) // ราคาต่อตันให้รถร่วม
  commission            Float?  @default(0) // จ่ายค่านายหน้า
  subcontractorDiff     Float?  @default(0) // ส่วนต่างรถร่วมที่ต้องจ่าย
  subcontractorFuelCost Float?  @default(0) // ค่าน้ำมันรถร่วม
  subcontractorWht      Float?  @default(0) // หัก ณ ที่จ่ายรถร่วม
  subcontractorNet      Float?  @default(0) // จำนวนเงินสุทธิรถร่วม
  subcontractorFuelLiters Float? @default(0) // น้ำมัน (L) รถร่วม
  subcontractorFuelPrice Float?  @default(0) // ราคาน้ำมันต่อลิตร (รถร่วม)
  isSubcontractorPaid   Boolean @default(false) // จ่ายรถร่วมแล้ว
  subcontractorPaidDate DateTime? // วันที่จ่ายรถร่วม

  // เลขไมล์และน้ำมัน (บริษัท)
  odometerStart   Float?    @default(0) // เลขไมล์ก่อนไป
  odometerEnd     Float?    @default(0) // เลขไมล์กลับมา
  distanceKm      Float?    @default(0) // กม. ที่ใช้ไป
  fuelLiters      Float?    @default(0) // เติมน้ำมัน (ลิตร)
  fuelEfficiency  Float?    @default(0) // กม./ลิตร
  fuelPricePerLiter Float?  @default(0) // ราคาต่อลิตร
  fuelCost        Float?    @default(0) // ค่าน้ำมันรถ

  // ค่าใช้จ่ายประจำเที่ยว (Trip Expenses)
  expenseLoadingUnloading Float @default(0) // ขึ้น ลง
  expenseFuelSavingBonus  Float @default(0) // พิเศษ(เซฟน้ำมัน)
  expenseExtraBonus       Float @default(0) // พิเศษ+เพิ่ม
  expenseAllowance        Float @default(0) // เบี้ยเลี้ยง
  expenseBackhaul         Float @default(0) // ของกลับ
  expenseExpressway       Float @default(0) // ทางด่วน
  expensePort             Float @default(0) // ค่าท่า
  expenseDetention        Float @default(0) // ตกค้าง
  expenseRepair           Float @default(0) // ค่าซ่อม
  expenseOther            Float @default(0) // อื่นๆ
  totalExpenses           Float @default(0) // รวม ค่าใช้จ่าย

  // กำไรสุทธิต่องาน
  netProfit               Float @default(0) // คงเหลือสุทธิต่องาน (netRevenue - totalExpenses)
  notes                   String?           // หมายเหตุ

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        MarketingCustomer? @relation(fields: [customerId], references: [id])

  @@index([customerName])
  @@index([licensePlate])
  @@index([driverName])
  @@index([invoiceNo])
  @@index([loadingDate])
}


